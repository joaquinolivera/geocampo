{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@geocampo/database": [
        "../../packages/database/src"
      ],
      "@geocampo/shared": [
        "../../packages/shared/src"
      ],
      "@geocampo/ui": [
        "../../packages/ui/src"
      ],
      "@/*": [
        "src/*"
      ],
      "@geocampo/i18n": [
        "../../packages/i18n/src"
      ],
      "@geocampo/i18n/*": [
        "../../packages/i18n/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "__mocks__"
  ]
}
